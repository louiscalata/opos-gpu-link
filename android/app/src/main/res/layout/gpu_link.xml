<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@color/newspaper_paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:accessibilityHeading="true" android:text="@string/link_title"
            android:textColor="@color/newspaper_ink" android:textSize="18sp"
                    />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:layout_marginBottom="16dp"
            android:text="@string/link_question" android:textColor="@color/newspaper_ink" android:textSize="18sp" />
        <Button android:id="@+id/open_link" android:layout_width="match_parent"
            android:layout_height="52dp" android:background="@drawable/button_primary"
            android:text="@string/open_link" android:textAllCaps="false" android:textColor="@color/newspaper_paper" />
        <Button android:id="@+id/later" android:layout_width="match_parent"
            android:layout_height="48dp" android:layout_marginTop="8dp"
            android:background="@drawable/button_outline"
            android:text="@string/later" android:textAllCaps="false" android:textColor="@color/newspaper_ink" />
    </LinearLayout>
</ScrollView>
