<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/newspaper_paper">

    <LinearLayout
        android:id="@+id/screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/newspaper_paper"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:text="@string/app_name"
            android:textColor="@color/newspaper_ink"
            android:textSize="18sp"
                    />

        <Button
            android:id="@+id/info"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="56dp"
            android:background="@drawable/newspaper_outline"
            android:contentDescription="@string/info_description"
            android:text="@string/info"
            android:textAllCaps="false"
            android:textColor="@color/newspaper_ink"
            android:textSize="16sp" />

        <Button
            android:id="@+id/settings"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:minWidth="72dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/newspaper_outline"
            android:contentDescription="@string/settings_description"
            android:text="@string/settings"
            android:textAllCaps="false"
            android:textColor="@color/newspaper_ink"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/connection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="16dp"
        android:paddingTop="6dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:text="@string/connecting"
        android:textColor="@color/newspaper_ink"
        android:textSize="18sp" />

    <LinearLayout
        android:id="@+id/composer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/question_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/prompt"
            android:text="@string/question_label"
            android:textColor="@color/newspaper_ink"
            android:textSize="18sp"
                    />

        <LinearLayout
            android:id="@+id/input_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <os.opos.launcher.SendEditText
            android:id="@+id/prompt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/newspaper_panel"
            android:gravity="top|start"
            android:hint="@string/question_hint"
            android:imeOptions="actionSend|flagNoExtractUi"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="5"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="@color/newspaper_ink"
            android:textColorHint="@color/newspaper_ink"
            android:textSize="18sp" />

        <Button
            android:id="@+id/ask"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/newspaper_primary"
            android:text="@string/send"
            android:textAllCaps="false"
            android:textColor="@color/newspaper_paper"
            android:textSize="18sp"
                    />

        <Button
            android:id="@+id/stop"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/newspaper_outline"
            android:text="@string/stop"
            android:textAllCaps="false"
            android:textColor="@color/newspaper_ink"
            android:textSize="18sp"
                    android:visibility="gone" />

        <Button
            android:id="@+id/reconnect"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/newspaper_primary"
            android:text="@string/reconnect"
            android:textAllCaps="false"
            android:textColor="@color/newspaper_paper"
            android:textSize="18sp"
                    android:visibility="gone" />

        <TextView
            android:id="@+id/reset_ask_copy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/reset_ask_copy"
            android:textColor="@color/newspaper_ink"
            android:textSize="18sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/reset_ask"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/newspaper_outline"
            android:text="@string/reset_ask"
            android:textAllCaps="false"
            android:textColor="@color/newspaper_ink"
            android:textSize="18sp"
            android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:textColor="@color/newspaper_ink"
        android:textSize="18sp" />

    <FrameLayout
        android:id="@+id/results_stage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/results_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="false">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/pairing_closed"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/newspaper_panel"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/pairing_closed_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/pairing_closed_title"
                    android:textColor="@color/newspaper_ink"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/pairing_closed_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/pairing_closed"
                    android:textColor="@color/newspaper_ink"
                    android:textSize="18sp" />

                <Button
                    android:id="@+id/reopen_pc"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/newspaper_primary"
                    android:text="@string/reopen_pc"
                    android:textAllCaps="false"
                    android:textColor="@color/newspaper_paper"
                    android:textSize="18sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/device_band"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:accessibilityLiveRegion="polite"
                android:importantForAccessibility="yes"
                android:screenReaderFocusable="true"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/device_phone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:background="@drawable/newspaper_panel"
                    android:importantForAccessibility="noHideDescendants"
                    android:minHeight="64dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/device_phone_kicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_phone_kicker"
                        android:textColor="@color/you_asked_label"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/device_phone_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_phone_name"
                        android:textColor="@color/newspaper_ink"
                        android:textSize="21sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/device_link"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_weight="0.9"
                    android:gravity="center"
                    android:importantForAccessibility="no"
                    android:text="@string/device_link_waiting"
                    android:textColor="@color/newspaper_ink"
                    android:textSize="11sp" />

                <LinearLayout
                    android:id="@+id/device_computer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:background="@drawable/newspaper_panel"
                    android:importantForAccessibility="noHideDescendants"
                    android:minHeight="64dp"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/device_computer_kicker"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_computer_kicker"
                        android:textColor="@color/you_asked_label"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/device_computer_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/device_computer_name"
                        android:textColor="@color/newspaper_ink"
                        android:textSize="21sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:accessibilityHeading="true"
                android:textColor="@color/newspaper_ink"
                android:textSize="18sp"
                    android:visibility="gone" />

            <LinearLayout
                android:id="@+id/answers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/phone_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/newspaper_panel"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/phone_heading"
                        android:textColor="@color/newspaper_ink"
                        android:textSize="18sp"
                    />

                    <TextView
                        android:id="@+id/phone_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/newspaper_ink"
                        android:textSize="18sp"
                    />

                    <TextView
                        android:id="@+id/phone_answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/newspaper_ink"
                        android:textIsSelectable="true"
                        android:textSize="18sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/gpu_card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/newspaper_panel"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/gpu_heading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:text="@string/gpu_heading_neutral"
                        android:textColor="@color/newspaper_ink"
                        android:textSize="18sp"
                    />

                    <TextView
                        android:id="@+id/gpu_state"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:accessibilityLiveRegion="polite"
                        android:textColor="@color/newspaper_ink"
                        android:textSize="18sp"
                    />

                    <TextView
                        android:id="@+id/gpu_answer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:textColor="@color/newspaper_ink"
                        android:textIsSelectable="true"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/retry"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/newspaper_outline"
                android:text="@string/try_again"
                android:textAllCaps="false"
                android:textColor="@color/newspaper_ink"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>
    </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/pairing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/newspaper_paper"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:id="@+id/pairing_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/pairing_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:id="@+id/pairing_header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:gravity="center_horizontal"
                    android:text="@string/pairing_title"
                    android:textColor="@color/newspaper_ink"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/pairing_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_horizontal"
                    android:textColor="@color/newspaper_ink"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/pairing_code_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:gravity="center_horizontal"
                    android:text="@string/pairing_code_label"
                    android:textColor="@color/newspaper_ink"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/pairing_code"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFeatureSettings="tnum"
                    android:gravity="center"
                    android:importantForAccessibility="yes"
                    android:letterSpacing="0.08"
                    android:textColor="@color/newspaper_ink"
                    android:textSize="56sp" />

                <TextView
                    android:id="@+id/pairing_countdown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:textColor="@color/newspaper_ink"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/pairing_disclosure"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:gravity="center_horizontal"
                    android:text="@string/pairing_disclosure"
                    android:textColor="@color/newspaper_ink"
                    android:textSize="18sp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout
            android:id="@+id/pairing_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="8dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <Button
                android:id="@+id/allow_pc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="72dp"
                android:background="@drawable/newspaper_primary"
                android:text="@string/allow_pc"
                android:textAllCaps="false"
                android:textColor="@color/newspaper_paper"
                android:textSize="21sp" />

            <Button
                android:id="@+id/deny_pc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/newspaper_outline"
                android:text="@string/not_now"
                android:textAllCaps="false"
                android:textColor="@color/newspaper_ink"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
